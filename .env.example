# Copy to .env and change the password. .env is gitignored and must stay that way.
#
# The port is 55432 rather than 5432 on purpose: a local Postgres, if you ever install
# one, takes 5432, and the collision produces a connection error that looks like a
# credentials problem.

POSTGRES_DB=carrier_iq
POSTGRES_USER=carrier_iq
POSTGRES_PASSWORD=change_me_before_starting
POSTGRES_PORT=55432
POSTGRES_HOST=localhost
